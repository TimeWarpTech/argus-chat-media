{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Bun": "Use a porta @creativepetabyte/argus-runtime. APIs do Bun s\u00f3 em packages/runtime/src/bun.ts."
            }
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "bun": "Use a porta @creativepetabyte/argus-runtime. APIs do Bun s\u00f3 em packages/runtime/src/bun.ts."
            },
            "patterns": [
              {
                "group": [
                  "bun:*"
                ],
                "message": "Use a porta @creativepetabyte/argus-runtime. APIs do Bun s\u00f3 em packages/runtime/src/bun.ts."
              },
              {
                "group": [
                  "../*",
                  "../**"
                ],
                "message": "N\u00e3o suba diret\u00f3rios com ../: use o alias # do pacote (ex.: #kernel/http/app)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/packages/runtime/src/bun.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off",
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tools/depcruise/fixtures/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/frontend/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Use a porta @creativepetabyte/argus-runtime. APIs do Bun s\u00f3 em packages/runtime/src/bun.ts.",
                  "fetch": "N\u00e3o chame o backend direto: use o cliente tipado de #api/client (@creativepetabyte/argus-api-client).",
                  "XMLHttpRequest": "N\u00e3o chame o backend direto: use o cliente tipado de #api/client (@creativepetabyte/argus-api-client)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/e2e-login.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
