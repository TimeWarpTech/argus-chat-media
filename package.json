{
  "name": "@creativepetabyte/argus-chat-media",
  "version": "0.1.0",
  "description": "Send a file through an Argus plugin contract call, in pieces that fit the 100 KB a call accepts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimeWarpTech/argus-chat-media.git"
  },
  "homepage": "https://github.com/TimeWarpTech/argus-chat-media#readme",
  "bugs": {
    "url": "https://github.com/TimeWarpTech/argus-chat-media/issues"
  },
  "keywords": [
    "argus",
    "plugin",
    "chat",
    "attachment",
    "upload"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "@types/node": "^26.6.5"
  }
}
